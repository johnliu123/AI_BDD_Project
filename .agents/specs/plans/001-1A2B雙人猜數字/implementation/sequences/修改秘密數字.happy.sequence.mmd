sequenceDiagram
    actor Player as 玩家
    participant API as SecretRouter.changeSecret
    participant Service as ChangeSecretService
    participant Rules as SecretNumberRules
    participant Repo as GameRepository
    participant DB as secrets / games

    Player->>API: PATCH /games/{gameId}/secrets/{playerId}(secret)
    API->>Service: change_secret(gameId, playerId, secret)
    Service->>Repo: load_game_with_secret(gameId, playerId)
    Repo->>DB: read game and secret
    Service->>Rules: ensure_before_guessing(game.phase)
    Service->>Rules: ensure_change_count_less_than_one(secret)
    Service->>Rules: validate_four_unique_digits(secret)
    Service->>Repo: update_secret_and_increment_change_count(playerId, secret)
    Repo->>DB: update secrets
    Service-->>API: GameStateResponse
    API-->>Player: phase
