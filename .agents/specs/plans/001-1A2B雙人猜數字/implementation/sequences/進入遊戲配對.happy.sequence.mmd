sequenceDiagram
    actor Player as 玩家
    participant API as GameRouter.enterGame
    participant Service as EnterGameService
    participant Repo as GameRepository
    participant DB as games / players

    Player->>API: POST /games(gameId, playerName)
    API->>Service: enter_game(gameId, playerName)
    Service->>Repo: find_by_game_id(gameId)
    alt game 不存在
        Service->>Repo: create_game(gameId, P1 playerName)
        Repo->>DB: insert games, players
        Service-->>API: role=P1, phase=WAITING_FOR_PLAYERS
    else game 可加入
        Service->>Repo: add_player_as_p2(game, playerName)
        Repo->>DB: insert players; update phase=SETTING_SECRETS
        Service-->>API: role=P2, phase=SETTING_SECRETS
    end
    API-->>Player: EnterGameResponse
